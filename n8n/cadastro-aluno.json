              "value": "={{ ({cadastro_aluno: \"Sua conta foi criada\", cadastro_usuario: \"Bem-vindo(a) à equipe\", senha_provisoria: \"Nova senha provisória\", recuperacao_senha: \"Recuperação de senha\"})[$json.body.evento] || \"Senha provisória\" }}",
              "type": "string"
            },
