    {
      "parameters": {
        "sendTo": "={{ $('Dados do e-mail').item.json.email }}",
        "subject": "={{ $('Dados do e-mail').item.json.assunto }}",
        "emailType": "html",
        "message": "=<div style=\"margin:0;padding:24px 12px;background:#f3f1fb;font-family:Arial,Helvetica,sans-serif;color:#1f1b2e\">\n  <div style=\"max-width:520px;margin:0 auto;background:#ffffff;border-radius:16px;overflow:hidden;border:1px solid #e4def7\">\n    <div style=\"background:linear-gradient(135deg,#7c3aed,#c026d3);padding:22px 28px;color:#ffffff\">\n      <div style=\"font-size:13px;letter-spacing:2px;text-transform:uppercase;opacity:.85\">ELO Campus</div>\n      <div style=\"font-size:22px;font-weight:bold;margin-top:6px\">{{ $('Dados do e-mail').item.json.titulo }}</div>\n    </div>\n    <div style=\"padding:26px 28px;font-size:15px;line-height:1.55\">\n      <p style=\"margin:0 0 14px\">Olá, <strong>{{ $('Dados do e-mail').item.json.primeiro_nome }}</strong>!</p>\n      <p style=\"margin:0 0 14px\">{{ $('Dados do e-mail').item.json.introducao }}</p>\n      {{ $('Dados do e-mail').item.json.evento === 'recuperacao_senha' ? '<p style=\"margin:0 0 14px;color:#5b5570;font-size:13px\">Pedido recebido em ' + $('Dados do e-mail').item.json.enviado_em + ' (horário de Brasília).</p>' : '' }}\n      <p style=\"margin:0 0 8px\">Use estes dados para entrar:</p>\n      <div style=\"background:#f7f5fd;border:1px solid #e4def7;border-radius:12px;padding:16px 18px;margin:0 0 16px\">\n        <div style=\"font-size:13px;color:#5b5570\">E-mail</div>\n        <div style=\"font-weight:bold;margin-bottom:10px\">{{ $('Dados do e-mail').item.json.email }}</div>\n        <div style=\"font-size:13px;color:#5b5570\">Senha provisória</div>\n        <div style=\"font-family:'Courier New',monospace;font-size:24px;font-weight:bold;letter-spacing:3px;color:#6d28d9\">{{ $('Dados do e-mail').item.json.senha_provisoria }}</div>\n      </div>\n      <p style=\"margin:0 0 14px\">Ela vale até <strong>{{ $('Dados do e-mail').item.json.senha_expira_em }}</strong>. Ao entrar, o sistema vai pedir que você crie a sua própria senha.</p>\n      <p style=\"text-align:center;margin:22px 0\">\n        <a href=\"{{ $('Dados do e-mail').item.json.link_acesso }}\" style=\"background:#7c3aed;color:#ffffff;text-decoration:none;padding:12px 26px;border-radius:999px;font-weight:bold;display:inline-block\">Acessar o ELO Campus</a>\n      </p>\n      <p style=\"margin:0;padding:12px 14px;background:#fff7ed;border-radius:10px;font-size:13px;color:#7c2d12\">{{ $('Dados do e-mail').item.json.aviso }}</p>\n    </div>\n    <div style=\"padding:14px 28px;background:#faf9fe;font-size:12px;color:#8a84a0;border-top:1px solid #eee9fb\">\n      Mensagem automática do ELO Campus. Não responda este e-mail.\n    </div>\n  </div>\n</div>",
        "options": {
          "appendAttribution": false
        }
