              "value": "={{ $now.setZone('America/Sao_Paulo').toFormat(\"dd/MM/yyyy 'às' HH:mm\") }}",
              "type": "string"
            },
            {
              "id": "2c3d4e5f-6a7b-4c8d-8e9f-1a2b3c4d5e6f",
              "name": "assunto",
              "value": "={{ ({cadastro_aluno: \"Bem-vindo(a) ao ELO Campus - sua senha de primeiro acesso\", cadastro_usuario: \"Sua conta da equipe ELO Campus foi criada\", senha_provisoria: \"ELO Campus - sua nova senha provisória\", recuperacao_senha: \"ELO Campus - recuperação de senha\"})[$json.body.evento] || \"ELO Campus - senha provisória\" }}",
              "type": "string"
            },
