# Copie para backend/.env e preencha. Em produção, estas variáveis ficam
# na aba Environment do serviço no Easypanel. Nunca coloque valores reais
# neste arquivo.

# --- Obrigatórias ---------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=elocampus
DB_USER=elocampus
DB_PASSWORD=troque-esta-senha

# Assina os tokens de login: texto longo e aleatório. Trocar desconecta
# todos os usuários.
FLASK_SECRET_KEY=troque-por-um-texto-longo-e-aleatorio

# --- E-mails pelo n8n -----------------------------------------------
# Sem esta URL, as senhas provisórias não são enviadas por e-mail.
# Base dos webhooks do n8n. O backend acrescenta o caminho de cada workflow:
#   cadastro-aluno (senhas), reservas (reserva aprovada) e enviar-email
#   (cobrança). Exemplo: https://elocampus-n8n.a6ti6s.easypanel.host/webhook/
N8N_WEBHOOK_BASE_URL=

# Opcional: URL completa de um workflow, que tem prioridade sobre a base.
N8N_CADASTRO_WEBHOOK_URL=
# Opcional: enviado no cabeçalho X-EloCampus-Webhook-Secret.
N8N_WEBHOOK_SECRET=

# Página gravada nos QR Codes das etiquetas. Etiqueta impressa não muda:
# defina o endereço definitivo antes de imprimir. Sem valor, usa o site do
# Easypanel (https://elocampus-frontend.a6ti6s.easypanel.host/pages/consulta-qr.html).
QR_CONSULTA_URL=

# Início do endereço gravado nos QR Codes novos (o backend acrescenta /<id>).
# Sem valor, usa o mesmo site de QR_CONSULTA_URL com /q (ex.: https://elocampus.com.br/q).
QR_ITEM_URL=

# Opcionais: URL completa de cada aviso. Empréstimo, devolução, equipamento
# e manutenção não usam a base (não há workflow): sem a URL, não são enviados.
N8N_EMPRESTIMO_WEBHOOK_URL=
N8N_DEVOLUCAO_WEBHOOK_URL=
N8N_RESERVA_WEBHOOK_URL=
N8N_EMAIL_WEBHOOK_URL=
N8N_EQUIPAMENTO_WEBHOOK_URL=
N8N_MANUTENCAO_WEBHOOK_URL=

# --- Automações -----------------------------------------------------
# Chave do monitoramento, dos lembretes e do relatório semanal
# (cabeçalho X-Monitor-Token).
MONITOR_TOKEN=

# Administrador master: e-mails (separados por vírgula) de admins que veem
# os IDs das pessoas e podem zerar os dados.
ADMIN_MASTER_EMAILS=

# --- Opcionais (os valores abaixo são os padrões) -------------------
# SENHA_PROVISORIA_HORAS=24
# SENHA_RECUPERACAO_MINUTOS=60

# Domínios aceitos em "Solicitar acesso", separados por vírgula. Vazio
# aceita qualquer e-mail. Exemplo: ufob.edu.br
# ACESSO_DOMINIOS_PERMITIDOS=

# Endereços do frontend autorizados, separados por vírgula.
# CORS_ORIGINS=https://elocampus.com.br,https://www.elocampus.com.br,https://elocampus-frontend.a6ti6s.easypanel.host
