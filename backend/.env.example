# Copie para backend/.env e preencha. Em produção, estas variáveis ficam
# na aba Environment do serviço no Easypanel. Nunca coloque valores reais
# neste arquivo.

# --- Obrigatórias ---------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=elocampus
DB_USER=elocampus
DB_PASSWORD=troque-esta-senha

# Assina os tokens de login: texto longo e aleatório. Trocar desconecta
# todos os usuários.
FLASK_SECRET_KEY=troque-por-um-texto-longo-e-aleatorio

# --- E-mails pelo n8n -----------------------------------------------
# Sem esta URL, as senhas provisórias não são enviadas por e-mail.
N8N_CADASTRO_WEBHOOK_URL=
# Opcional: enviado no cabeçalho X-EloCampus-Webhook-Secret.
N8N_WEBHOOK_SECRET=

# Opcionais: avisos de cada evento. Sem elas, o evento só não é enviado.
N8N_EMPRESTIMO_WEBHOOK_URL=
N8N_DEVOLUCAO_WEBHOOK_URL=
N8N_RESERVA_WEBHOOK_URL=
N8N_EQUIPAMENTO_WEBHOOK_URL=
N8N_MANUTENCAO_WEBHOOK_URL=

# --- Automações -----------------------------------------------------
# Chave do monitoramento, dos lembretes e do relatório semanal
# (cabeçalho X-Monitor-Token).
MONITOR_TOKEN=

# --- Opcionais (os valores abaixo são os padrões) -------------------
# SENHA_PROVISORIA_HORAS=24
# SENHA_RECUPERACAO_MINUTOS=60

# Domínios aceitos em "Solicitar acesso", separados por vírgula. Vazio
# aceita qualquer e-mail. Exemplo: ufob.edu.br
# ACESSO_DOMINIOS_PERMITIDOS=

# Endereços do frontend autorizados, separados por vírgula.
# CORS_ORIGINS=https://elocampus.com.br,https://www.elocampus.com.br,https://elocampus-frontend.a6ti6s.easypanel.host
